---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FundraisingProgress from '../../components/FundraisingProgress.astro';

// TODO: Replace with the real LGL campaign ID for the Scholarship Fund
const SCHOLARSHIP_CAMPAIGN_ID = 'TODO';
---

<BaseLayout
  title="Support a Player's Education — Scholarships"
  description="Help fund scholarships to Houston City College's intensive English program for the upcoming fall semester."
>

  <!-- ============ CAMPAIGN HERO ============ -->
  <section class="schol-hero">
    <div class="schol-hero-bg" aria-hidden="true"></div>
    <div class="container schol-hero-content" style="max-width: 820px;">
      <p class="page-label">Scholarship Fund</p>
      <h1>Support a Player's Education</h1>
      <p class="schol-hero-sub">
        Help fund scholarships to Houston City College's intensive English program for the upcoming fall semester.
      </p>
    </div>
  </section>

  <!-- ============ PHOTO + STORY | DONATION FORM ============ -->
  <section class="section schol-two-col-section">
    <div class="container">
      <div class="schol-two-col">

        <!-- LEFT: photo + story -->
        <div class="schol-left schol-card">
          <p class="schol-label">Education</p>
          <h2 class="schol-heading">Fall Scholarships</h2>
          <p class="schol-lead">Education is vital for our players' success on and off the field. English is the first step.</p>
          <img
            src="/images/timeline/11-english-classes.jpeg"
            alt="Houston Shine FC players in English class"
            class="schol-photo"
          />
          <p class="schol-body">
            Many of our players were too old to attend high school by the time they arrived in Houston as refugees, and had to begin working right away. Friends and family in the Shine community are raising funds for scholarships to Houston City College's intensive English program for the fall semester. Through this effort, our players will create a foundation for better career opportunities as they further establish their lives in Houston.
          </p>
        </div>

        <!-- RIGHT: donation form -->
        <div class="schol-card">
          <p class="schol-label">Fall Campaign</p>
          <h2 class="schol-heading">Make a Donation</h2>
          <FundraisingProgress campaignId={SCHOLARSHIP_CAMPAIGN_ID} goal={7000} />
          <iframe
            onload="window.parent.scrollTo(0,0)"
            height="1100"
            allowtransparency="true"
            allow="payment"
            frameborder="0"
            scrolling="no"
            style="width:100%;border:none;display:block;"
            src="https://secure.lglforms.com/form_engine/s/Jlv1P-m3SSyB9D8sWvXVgQ"
            title="Scholarship Fund Donation Form"
          ><a href="https://secure.lglforms.com/form_engine/s/Jlv1P-m3SSyB9D8sWvXVgQ">Donate to the Scholarship Fund</a></iframe>
          <p class="lgl-note">After submitting your payment information, please do not close this window until you receive confirmation. Thank you for your support!</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ============ FOOTER STRIP ============ -->
  <section class="schol-footer-strip">
    <div class="container schol-footer-inner">
      <p class="schol-tax">
        Houston Shine FC is a registered non-profit organization. Your contributions are tax-deductible.
      </p>
      <a href="/support" class="schol-back-link">← Back to all ways to support</a>
    </div>
  </section>

</BaseLayout>

<style>
  .lgl-note {
    margin-top: 12px;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.8125rem;
    font-style: italic;
    color: #5A6B7A;
    text-align: center;
    line-height: 1.5;
  }

  /* ── Hero ── */
  .schol-hero {
    position: relative;
    background-color: var(--color-navy);
    padding: 5.5rem 0 4.5rem;
    overflow: hidden;
  }

  .schol-hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 80% 50%, rgba(212, 160, 60, 0.12) 0%, transparent 60%),
      radial-gradient(ellipse at 10% 80%, rgba(27, 122, 84, 0.08) 0%, transparent 50%);
    pointer-events: none;
  }

  .schol-hero-content {
    position: relative;
    z-index: 1;
  }

  .schol-hero .page-label {
    color: var(--color-gold);
    opacity: 0.9;
  }

  .schol-hero h1 {
    color: var(--color-white);
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    letter-spacing: -0.03em;
    margin-bottom: 1.25rem;
    line-height: 1.05;
  }

  .schol-hero-sub {
    font-size: 1.125rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.75);
    max-width: 640px;
  }

  /* ── Two-column layout ── */
  .schol-two-col-section {
    padding-top: 3.5rem;
    padding-bottom: 4rem;
  }

  .schol-two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    align-items: stretch;
  }

  .schol-left {
    display: flex;
    flex-direction: column;
  }

  .schol-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin: 0 0 0.5rem;
  }

  .schol-heading {
    font-size: 1.375rem;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }

  .schol-lead {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.25rem;
    line-height: 1.55;
    color: var(--color-navy);
    margin: 0 0 1.25rem;
    padding-left: 1rem;
    border-left: 2px solid var(--color-gold);
  }

  .schol-photo {
    display: block;
    width: 100%;
    max-height: 340px;
    object-fit: cover;
    border-radius: var(--radius-card);
    margin-bottom: 1.25rem;
  }

  .schol-body {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* ── Donation card ── */
  .schol-card {
    padding: 2rem;
    border-radius: var(--radius-card);
    border: 1px solid rgba(11, 37, 69, 0.08);
    background: var(--color-warm-white);
  }

  /* ── Footer strip ── */
  .schol-footer-strip {
    background: var(--color-warm-white);
    border-top: 1px solid rgba(11, 37, 69, 0.08);
    padding: 2.5rem 0;
  }

  .schol-footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
  }

  .schol-tax {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .schol-back-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-gold);
    text-decoration: none;
    letter-spacing: 0.01em;
    transition: opacity var(--transition-base);
  }

  .schol-back-link:hover {
    opacity: 0.75;
  }

  /* ── Page label ── */
  .page-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.875rem;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .schol-two-col {
      grid-template-columns: 1fr;
    }

    .schol-card {
      padding: 1.5rem 0.75rem;
    }
  }
</style>
