---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Houston Shine Goes to Washington"
  description="Thanks to the generous support of the Shine community, the team is able to travel to Washington, DC for the Tawana Tournament. Check back soon for photos and a recap of the weekend."
>

  <!-- ============ CAMPAIGN HERO ============ -->
  <section class="wash-hero">
    <div class="wash-hero-bg" aria-hidden="true"></div>
    <div class="container wash-hero-content" style="max-width: 820px;">
      <p class="page-label">Season Highlight</p>
      <h1>Houston Shine Goes<br />to Washington</h1>
      <p class="wash-hero-sub">
        Thanks to the generous support of the Shine community, the team is able to travel to Washington, DC for the Tawana Tournament. This page will be updated with photos and a recap of the weekend — check back soon!
      </p>
    </div>
  </section>

  <!-- ============ ABOUT THE TOURNAMENT ============ -->
  <section class="section" style="padding-top: 4rem; padding-bottom: 1.5rem;">
    <div class="container" style="max-width: 820px;">
      <h2 class="wash-section-heading">About the Tournament</h2>
      <p class="wash-body">
        The tournament is hosted by <a href="https://www.thetawana.org/tawana-eastcoast-tournament" target="_blank" rel="noopener noreferrer" class="wash-link">The Tawana</a>, a non-profit organization for Afghan women's sports in the U.S. Small-sided games will be held at Montgomery College in Rockville, Maryland on August 15. The event coincides with the 5-year anniversary of the American withdrawal from Afghanistan.
      </p>
      <p class="wash-body">
        Afghan women soccer players resettled across the East Coast, Midwest, and Texas are traveling to the DC area to play. Many have not seen each other since they were evacuated five years ago.
      </p>
    </div>
  </section>

  <!-- ============ FOOTER STRIP ============ -->
  <section class="wash-footer-strip">
    <div class="container wash-footer-inner">
      <p class="wash-tax">
        Thank you to everyone in the Shine community who made this trip possible.
      </p>
      <a href="/story" class="wash-back-link">← Back to Our Story</a>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Hero ── */
  .wash-hero {
    position: relative;
    background-color: var(--color-navy);
    padding: 5.5rem 0 4.5rem;
    overflow: hidden;
  }

  .wash-hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 80% 50%, rgba(212, 160, 60, 0.12) 0%, transparent 60%),
      radial-gradient(ellipse at 10% 80%, rgba(27, 122, 84, 0.08) 0%, transparent 50%);
    pointer-events: none;
  }

  .wash-hero-content {
    position: relative;
    z-index: 1;
  }

  .wash-hero .page-label {
    color: var(--color-gold);
    opacity: 0.9;
  }

  .wash-hero h1 {
    color: var(--color-white);
    font-size: clamp(2.5rem, 7vw, 4.25rem);
    letter-spacing: -0.03em;
    margin-bottom: 1.25rem;
    line-height: 1.05;
  }

  .wash-hero-sub {
    font-size: 1.125rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 2rem;
  }

  /* ── About section ── */
  .wash-section-heading {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: 1.25rem;
  }

  .wash-body {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-text-secondary);
    margin-bottom: 1.25rem;
  }

  .wash-link {
    color: var(--color-navy);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--transition-base);
  }

  .wash-link:hover {
    color: var(--color-gold);
  }

  /* ── Footer strip ── */
  .wash-footer-strip {
    background: var(--color-warm-white);
    border-top: 1px solid rgba(11, 37, 69, 0.08);
    padding: 2.5rem 0;
  }

  .wash-footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
  }

  .wash-tax {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .wash-back-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-gold);
    text-decoration: none;
    letter-spacing: 0.01em;
    transition: opacity var(--transition-base);
  }

  .wash-back-link:hover {
    opacity: 0.75;
  }

  /* ── Page label ── */
  .page-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.875rem;
  }

</style>
