               and will work as-is once this block is restored. -->
          <!--
          <div class="support-card uniforms-card" id="uniforms">
            <div class="uniforms-card-body">
              <div class="uniforms-card-left">
                <p class="support-label uniforms-label">Fall Jersey Drive</p>
                <h2 class="support-heading uniforms-heading">Dress the Team</h2>
                <p class="uniforms-desc">Help outfit a player for the fall season. Each jersey is <strong>$49.99</strong>.</p>
                <button class="btn btn-gold uniforms-open-btn" data-dialog="uniforms-modal">Donate a Jersey</button>
              </div>
              <div class="uniforms-card-right">
                <img
                  src="/images/general/uniform-temp_01.png"
                  alt="Houston Shine FC player in uniform"
                  class="uniforms-jersey-img"
                />
              </div>
            </div>
          </div>

          <dialog id="uniforms-modal" class="uniforms-modal">
            <div class="uniforms-modal-inner">
              <button class="uniforms-modal-close" aria-label="Close donation form">&#x2715;</button>
              <p class="wash-label" style="margin-bottom: 0.25rem;">Fall Jersey Drive</p>
              <h2 class="wash-heading" style="margin-bottom: 0.5rem;">Donate a Jersey</h2>
              <p class="uniforms-modal-sub">Each jersey is $49.99.</p>
              <iframe
                onload="window.parent.scrollTo(0,0)"
                height="1100"
                allowtransparency="true"
                allow="payment"
                frameborder="0"
                scrolling="no"
                style="width:100%;border:none;display:block;"
                src="about:blank"
                data-src="https://secure.lglforms.com/form_engine/s/vzExrXR0O7fE4oTTxzB-Gg"
                title="Fall Jersey Drive Donation Form"
              ><a href="TODO_LGL_FORM_URL">Donate a Jersey</a></iframe>
              <p class="lgl-note">After submitting your payment information, please do not close this window until you receive confirmation. Thank you for your support!</p>
            </div>
          </dialog>
          -->

          <!-- 100% card -->
          <div class="support-card hundred-card">
            <div class="hundred-band">
              <div class="hundred-graphic" aria-hidden="true">
                <p class="hundred-number" data-count="100" data-format="{n}%">100%</p>
              </div>
              <p class="hundred-text">
                Thanks to the generous support of our community who fund our operational expenses and volunteer their time, <strong>100% of your donation</strong> directly funds the effort to improve the Shine players' lives on and off the field.
              </p>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>


<script>
  document.querySelectorAll('.donate-scroll').forEach(link => {
    link.addEventListener('click', e => {
      e.preventDefault();
      document.getElementById('donate')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  document.querySelectorAll('.uniforms-scroll').forEach(link => {
    link.addEventListener('click', e => {
      e.preventDefault();
      document.getElementById('uniforms')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  // Modal open/close
  document.querySelectorAll('[data-dialog]').forEach(btn => {
    btn.addEventListener('click', () => {
      const modal = document.getElementById(btn.dataset.dialog);
      if (!modal) return;
      // Lazy-load the iframe src on first open
      const iframe = modal.querySelector('iframe[data-src]');
      if (iframe && iframe.getAttribute('src') === 'about:blank') {
        iframe.src = iframe.dataset.src;
      }
      modal.showModal();
      document.body.style.overflow = 'hidden';
    });
  });

  document.querySelectorAll('.uniforms-modal-close').forEach(btn => {
    btn.addEventListener('click', () => {
      btn.closest('dialog')?.close();
      document.body.style.overflow = '';
    });
  });

  document.querySelectorAll('.uniforms-modal').forEach(modal => {
    modal.addEventListener('click', e => {
      if (e.target === modal) {
        modal.close();
        document.body.style.overflow = '';
      }
    });
  });
</script>

<script>
  (() => {
    const DURATION = 1400;
    const EASE = (t) => 1 - Math.pow(1 - t, 3);

    function animateStat(el) {
      const target = parseInt(el.dataset.count, 10);
      const format = el.dataset.format;
      const start = performance.now();

      function tick(now) {
        const elapsed = now - start;
        const progress = Math.min(elapsed / DURATION, 1);
        const value = Math.round(EASE(progress) * target);
        el.textContent = format.replace('{n}', value);
        if (progress < 1) requestAnimationFrame(tick);
      }

      el.textContent = format.replace('{n}', '0');
      requestAnimationFrame(tick);
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          animateStat(entry.target);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.4 });

    document.querySelectorAll('.hundred-number[data-count]').forEach(el => observer.observe(el));
  })();
</script>

</BaseLayout>

<style>
  .lgl-note {
    margin-top: 12px;
    margin-bottom: -2rem;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.8125rem;
    font-style: italic;
    color: #5A6B7A;
    text-align: center;
    line-height: 1.5;
  }

  /* ── Campaign Strip ── */
  .campaign-strip {
    background-color: var(--color-navy);
    padding: 1.75rem 0;
  }

  .campaign-strip-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .campaign-strip-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.12);
    margin: 1.25rem 0;
  }

  .campaign-strip-text {
    flex: 1;
    min-width: 200px;
    max-width: 50%;
  }

  .campaign-strip-label {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin: 0 0 0.25rem;
  }

  .campaign-strip-heading {
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-white);
    margin: 0 0 0.25rem;
  }

  .campaign-strip-sub {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.65);
    margin: 0;
    line-height: 1.5;
  }

  .campaign-strip-btn {
    flex-shrink: 0;
    width: 160px;
    text-align: center;
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    .campaign-strip-row {
      flex-direction: column;
      align-items: flex-start;
    }
    .campaign-strip-text {
      max-width: 100%;
    }
    .campaign-strip-btn {
      width: 100%;
      text-align: center;
    }
  }

  /* ── Uniforms Campaign Card ── */
  .support-card.uniforms-card {
    background-color: var(--color-navy);
    border-color: transparent;
    scroll-margin-top: 80px;
    padding: 1rem 1rem 1rem 2rem;
  }

  .uniforms-card-body {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .uniforms-card-left {
    flex: 1;
    min-width: 0;
  }

  .uniforms-card-right {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .uniforms-label {
    color: var(--color-gold);
  }

  .uniforms-jersey-img {
    display: block;
    max-height: 220px;
    width: auto;
    border-radius: 6px;
    transform-origin: center bottom;
    filter:
      drop-shadow(2px 0 0 white)
      drop-shadow(-2px 0 0 white)
      drop-shadow(0 2px 0 white)
      drop-shadow(0 -2px 0 white)
      drop-shadow(1px 1px 0 white)
      drop-shadow(-1px -1px 0 white)
      drop-shadow(-1px 1px 0 white)
      drop-shadow(1px -1px 0 white);
  }

  @keyframes jersey-shake {
    0%, 100% { transform: rotate(0deg) scale(1.03); }
    15%       { transform: rotate(-4deg) scale(1.03); }
    30%       { transform: rotate(4deg) scale(1.03); }
    45%       { transform: rotate(-2.5deg) scale(1.03); }
    60%       { transform: rotate(2.5deg) scale(1.03); }
    75%       { transform: rotate(-1deg) scale(1.03); }
    90%       { transform: rotate(1deg) scale(1.03); }
  }

  .uniforms-jersey-img:hover {
    animation: jersey-shake 0.65s ease;
  }

  .uniforms-heading {
    color: var(--color-white);
  }

  .uniforms-desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 1.25rem;
  }

  .uniforms-desc strong {
    color: var(--color-white);
  }

  @media (max-width: 480px) {
    .uniforms-card-body {
      flex-direction: column-reverse;
    }
    .uniforms-jersey-img {
      height: 180px;
    }
  }

  .btn-gold {
    display: inline-block;
    background: var(--color-gold);
    color: var(--color-navy);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-btn, 6px);
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: opacity 0.2s ease;
    width: 100%;
    text-align: center;
  }

  .btn-gold:hover {
    opacity: 0.88;
  }

  /* ── Uniforms Modal ── */
  .uniforms-modal {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    margin: 0;
    width: min(640px, 95vw);
    max-height: 92vh;
    padding: 0;
    border: none;
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: 0 24px 64px rgba(11, 37, 69, 0.28);
  }

  .uniforms-modal::backdrop {
    background: rgba(11, 37, 69, 0.55);
    backdrop-filter: blur(3px);
  }

  .uniforms-modal-inner {
    padding: 2rem;
    overflow-y: auto;
    max-height: 92vh;
  }

  .uniforms-modal-close {
    display: block;
    margin-left: auto;
    margin-bottom: 1.25rem;
    background: none;
    border: none;
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    cursor: pointer;
    padding: 0.25rem 0.5rem;
    line-height: 1;
    transition: color 0.2s ease;
  }

  .uniforms-modal-close:hover {
    color: var(--color-navy);
  }

  .uniforms-modal-sub {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: 1.25rem;
  }

  /* ── Support Hero ── */
  .support-hero {
    position: relative;
    background-color: var(--color-warm-white);
    padding: 5rem 0 4rem;
    overflow: hidden;
  }

  .support-hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }

  .support-hero-overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(255, 255, 255, 0.70);
    z-index: 1;
  }

  .support-hero-content {
    position: relative;
    z-index: 2;
  }

  .support-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    align-items: stretch;
  }

  .support-right {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .hundred-card {
    flex: 1;
    display: flex;
    align-items: flex-start;
  }

  @media (max-width: 768px) {
    .support-layout {
      grid-template-columns: 1fr;
    }

    #donate {
      padding-left: 0.75rem;
      padding-right: 0.75rem;
    }
  }

  .support-card {
    padding: 2rem;
    border-radius: var(--radius-card);
    border: 1px solid rgba(11, 37, 69, 0.08);
    background: var(--color-warm-white);
  }

  /* ── Impact Grid ── */
  .impact-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 2rem 1rem;
  }

  .impact-item {
    display: flex;
  }

  .impact-circle {
    position: relative;
    aspect-ratio: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 20%;
    gap: 0.375rem;
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  .impact-circle::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/images/general/soccer-logo.png') center / contain no-repeat;
    filter: brightness(0) invert(1) sepia(8%) brightness(97%);
    z-index: 0;
  }

  .impact-circle > p {
    position: relative;
    z-index: 1;
  }

  .impact-circle:hover {
    animation: ball-bounce 1.0s ease forwards;
  }

  .impact-circle:hover::before {
    animation: ball-spin 1.0s ease-in-out;
  }

  @keyframes ball-bounce {
    0%   { transform: translateY(0) scale(1.05); }
    12%  { transform: translateY(-6px) scale(1.05); }
    22%  { transform: translateY(0) scale(1.05); }
    40%  { transform: translateY(-14px) scale(1.05); }
    55%  { transform: translateY(0) scale(1.05); }
    70%  { transform: translateY(-5px) scale(1.05); }
    85%  { transform: translateY(0) scale(1.05); }
    100% { transform: translateY(0) scale(1.05); }
  }

  @keyframes ball-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .impact-amount {
    font-size: clamp(1.75rem, 3.5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--color-gold);
    margin: 0;
    line-height: 1;
  }

  .impact-desc {
    font-size: clamp(0.6rem, 0.9vw, 0.75rem);
    font-weight: 600;
    color: var(--color-navy);
    line-height: 1.3;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }


  @media (max-width: 768px) {
    .impact-grid {
      grid-template-columns: repeat(3, minmax(0, 110px));
      justify-content: center;
      gap: 1rem 0.75rem;
      padding: 0;
    }
  }

  /* ── 100% Band ── */
  .hundred-band {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .hundred-graphic {
    flex-shrink: 0;
  }

  .hundred-number {
    font-size: clamp(3rem, 5.5vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: transparent;
    -webkit-text-stroke: 2px var(--color-navy);
    line-height: 1;
    margin: 0;
  }

  .hundred-text {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .hundred-text strong {
    color: var(--color-navy);
    font-weight: 700;
  }


  /* ── Support Cards ── */
  .support-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 0.5rem;
  }

  .support-heading {
    font-size: 1.375rem;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

</style>
