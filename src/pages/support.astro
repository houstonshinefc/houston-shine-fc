    <div class="container">

      <div class="campaign-strip-row">
        <div class="campaign-strip-text">
          <p class="campaign-strip-label">Current Campaigns</p>
          <p class="campaign-strip-heading">Fall Scholarships</p>
          <p class="campaign-strip-sub">Help fund scholarships to Houston City College's intensive English program for the upcoming fall semester.</p>
        </div>
        <a href="/support/scholarships" class="btn btn-primary campaign-strip-btn">Learn More</a>
      </div>

    </div>
  </section>

  <!-- ============ IMPACT GRID ============ -->
  <section class="section" style="padding-top: 3.5rem; padding-bottom: 2.75rem;">
    <div class="container">
<div class="impact-grid">

        <div class="impact-item">
          <a href="#donate" class="impact-circle donate-scroll">
            <p class="impact-amount">$25</p>
            <p class="impact-desc">Snacks & refreshments</p>
          </a>
        </div>

        <div class="impact-item">
          <a href="#donate" class="impact-circle donate-scroll">
            <p class="impact-amount">$50</p>
            <p class="impact-desc">One pair of cleats</p>
          </a>
        </div>

        <div class="impact-item">
          <a href="#donate" class="impact-circle donate-scroll">
            <p class="impact-amount">$100</p>
            <p class="impact-desc">One uniform kit</p>
          </a>
        </div>

        <div class="impact-item">
          <a href="#donate" class="impact-circle donate-scroll">
            <p class="impact-amount">$250</p>
            <p class="impact-desc">Year of wifi <span style="white-space: nowrap;">(via Compudopt)</span></p>
          </a>
        </div>

        <div class="impact-item">
          <a href="#donate" class="impact-circle donate-scroll">
            <p class="impact-amount">$600</p>
            <p class="impact-desc">One semester of English</p>
          </a>
        </div>

        <div class="impact-item">
          <a href="#donate" class="impact-circle donate-scroll">
            <p class="impact-amount">$2,500</p>
